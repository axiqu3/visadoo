{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/event/:slug",
      "destination": "/events/event.html"
    },
    {
      "source": "/article/:slug",
      "destination": "/articles/article.html"
    },
    {
      "source": "/country/:slug",
      "destination": "/country.html"
    }
  ]
}